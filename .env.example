# ElevenLabs — natural voice for About story (▷ button)
# Get keys: https://elevenlabs.io
#
# Pick a young male voice with West African / Ghanaian tone from your Voice Library,
# or clone a voice, then paste its Voice ID below.

VITE_ELEVENLABS_VOICE_ID=your_voice_id_here

# Production: client-side key (visible in browser bundle — use a restricted key)
VITE_ELEVENLABS_API_KEY=your_api_key_here

# Local dev only: optional server-side key (used by Vite proxy — not exposed to browser)
# Add to .env.local (gitignored) as ELEVENLABS_API_KEY=...
